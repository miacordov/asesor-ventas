{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Aplicación (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pruebas del archivo abierto",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
